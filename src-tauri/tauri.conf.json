{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sottovoce",
  "version": "0.1.0",
  "identifier": "com.giuseppeconcas.sottovoce",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sottovoce",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "Entitlements.plist"
    }
  }
}
