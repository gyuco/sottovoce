{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability della finestra principale e del widget overlay",
  "windows": ["main", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-request-user-attention",
    "dialog:allow-open"
